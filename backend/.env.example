# Server
NODE_ENV=development
PORT=5000

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase API (optionnel pour client frontend / stockage)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key

# JWT
JWT_SECRET=change_me_in_production_avec_une_cle_longue_et_aleatoire
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=change_me_refresh_token_secret_aussi
JWT_REFRESH_EXPIRE=30d

# Frontend URL (pour CORS)
FRONTEND_URL=http://localhost:3000

# Comptes de développement/initialisation (obligatoires pour le seed)
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
ULTRA_ADMIN_EMAIL=
ULTRA_ADMIN_PASSWORD=

# Transactional Emails (Resend API)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="Le Monde du Travail <onboarding@resend.dev>"
# Adresse qui reçoit les réponses aux emails du site
EMAIL_REPLY_TO=lemondedutravailsen@gmail.com

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:contact@mondedutravail.com

# Stockage des fichiers — requis en production pour l'upload d'images
# Sans configuration, l'upload est refusé en production (simulé en développement).
# Option 1 (recommandée) : Supabase Storage via son API compatible S3
#   Supabase > Storage > S3 Connection (endpoint, région, clés d'accès)
STORAGE_S3_ENDPOINT=https://[PROJECT-REF].storage.supabase.co/storage/v1/s3
STORAGE_S3_REGION=eu-west-2
STORAGE_ACCESS_KEY_ID=your_storage_access_key_id
STORAGE_SECRET_ACCESS_KEY=your_storage_secret_access_key
STORAGE_BUCKET=media
STORAGE_PUBLIC_URL=https://[PROJECT-REF].supabase.co/storage/v1/object/public/media
# Cloudflare R2 (recommandé, stockage en production) : renseigner les STORAGE_* ci-dessus avec
#   STORAGE_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com  STORAGE_S3_REGION=auto
#   STORAGE_BUCKET=lemondedutravail-media  STORAGE_PUBLIC_URL=https://media.lemondedutravail.org
# Déménagement des fichiers existants : DEST_* = nouveau stockage, puis `npm run storage:migrate -- --dry`
# Option 2 : Cloudflare R2 (utilisée seulement si STORAGE_S3_ENDPOINT est vide)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=monde-du-travail-assets
R2_PUBLIC_DOMAIN=https://media.example.com

# Suivi des erreurs serveur (Sentry) — optionnel, inactif si vide
# Sentry > Settings > Projects > Client Keys (DSN)
SENTRY_DSN=

# Visio intégrée au site — JaaS (Jitsi as a Service, 8x8) — optionnel
# Vide : la salle virtuelle utilise meet.jit.si dans un nouvel onglet.
# jaas.8x8.vc > API Keys : AppID (vpaas-magic-cookie-…), Key ID de la clé publique déposée,
# et la clé privée correspondante (PEM complet, retours à la ligne ou « \n »).
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY=
