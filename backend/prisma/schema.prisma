generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model MembershipRequest {
  id         String           @id @default(cuid())
  userId     String
  motivation String
  status     MembershipStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("membership_requests")
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String
  type        EventType
  location    String
  eventDate   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  createdBy   User      @relation("EventCreator", fields: [createdById], references: [id])

  @@map("events")
}

model Job {
  id             String        @id @default(cuid())
  title          String
  description    String
  content        String?
  category       JobCategory
  domain         String?
  icon           String?
  image          String?
  salary         String?
  skills         String[]      @default([])
  prerequisites  String?
  studies        String?
  advantages     String?
  disadvantages  String?
  subProfessions String[]      @default([])
  videoUrl       String?
  location       String?
  status         ContentStatus @default(DRAFT)
  saviezVous     Json?
  createdById    String?
  createdBy      User?         @relation("JobCreator", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([category])
  @@map("jobs")
}

model Formation {
  id             String        @id @default(cuid())
  // Identifiant lisible, lien avec la fiche pédagogique frontend/data/formations/<slug>.json
  slug           String?       @unique
  title          String
  description    String
  content        String?
  category       String?
  icon           String?
  image          String?
  startDate      DateTime?
  endDate        DateTime?
  duration       String?
  location       String?
  objectives     String?
  prerequisites  String?
  targetAudience String?
  syllabus       Json?
  certification  String?
  videoUrl       String?
  status         ContentStatus @default(DRAFT)
  createdById    String?
  createdBy      User?         @relation("FormationCreator", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  registrations FormationRegistration[]
  trainers      FormationTrainer[]
  mentorReports MentorReport[]

  // Salle Virtuelle (Visioconférence Jitsi Meet)
  visioEnabled      Boolean?  @default(false)
  visioRoomId       String?
  visioStatus       String?   @default("INACTIVE")
  visioScheduledAt  DateTime?
  visioRecordingUrl String?

  @@index([status])
  @@index([category])
  @@map("formations")
}

// Rubrique « Concours & opportunités » : bourses, concours, examens, admissions.
// Une annonce ne peut être publiée qu'avec un lien officiel et une date de
// vérification (pas d'opportunité non sourcée présentée comme confirmée).
model Opportunity {
  id             String        @id @default(cuid())
  title          String
  organization   String
  category       String
  summary        String
  details        String?
  eligibility    String?
  levels         String[]      @default([])
  destination    String?
  country        String?
  openingDate    DateTime?
  deadline       DateTime?
  keyDates       Json?
  documents      String[]      @default([])
  benefits       String?
  officialUrl    String?
  lastVerifiedAt DateTime?
  // Forçage manuel de la phase (ex. RESULTS) ; null = calculée depuis les dates
  phaseOverride  String?
  image          String?
  // Identifiant stable des annonces importées (scripts/data/opportunites) : réimport sans doublon
  slug           String?       @unique
  // Fiche concours : frais, épreuves [{ subject, duration?, coefficient? }], séries du bac, âge, places
  fees           String?
  exams          Json?
  series         String[]      @default([])
  ageLimit       String?
  places         Int?
  applyMode      String?
  contact        String?
  // Origine de l'information quand elle n'a pas encore été revérifiée sur le site officiel
  sourceNote     String?
  // Concours ou bourse annuels : une fois la session passée, on annonce la prochaine (usualPeriod)
  recurring      Boolean       @default(false)
  usualPeriod    String?
  status         ContentStatus @default(DRAFT)
  createdById    String?
  createdBy      User?         @relation("OpportunityCreator", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, deadline])
  @@index([category])
  @@map("opportunities")
}

model FormationRegistration {
  id          String   @id @default(cuid())
  formationId String
  userId      String?
  name        String
  email       String
  phone       String?
  motivation  String?
  status      String   @default("CONFIRMED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  formation Formation @relation(fields: [formationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User?     @relation("UserFormationRegistrations", fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([formationId])
  @@index([userId])
  @@index([email])
  @@map("formation_registrations")
}

model Post {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  excerpt     String?
  content     String
  coverImage  String?
  gallery     String[]
  category    PostCategory
  status      PostStatus   @default(DRAFT)
  featured    Boolean      @default(false)
  views       Int          @default(0)
  readingTime Int          @default(3)
  likeCount   Int          @default(0)
  tags        String[]     @default([])
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  likes       PostLike[]

  @@index([status])
  @@index([publishedAt])
  @@index([category])
  @@index([likeCount], map: "posts_like_count_idx")
  @@index([views])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User     @relation("UserPostLikes", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([postId, userId], map: "post_likes_post_user_unique")
  @@index([postId], map: "post_likes_post_idx")
  @@index([userId], map: "post_likes_user_idx")
  @@map("post_likes")
}

model Topic {
  id             String        @id @default(cuid())
  title          String
  content        String
  category       String
  replyCount     Int           @default(0)
  likeCount      Int           @default(0)
  views          Int           @default(0)
  bestReplyId    String?
  isLocked       Boolean       @default(false)
  isPinned       Boolean       @default(false)
  isResolved     Boolean       @default(false)
  isEdited       Boolean       @default(false)
  editedAt       DateTime?     @db.Timestamptz(6)
  lastActivityAt DateTime      @default(now())
  tags           String[]      @default([])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  authorId       String
  author         User          @relation(fields: [authorId], references: [id])
  replies        Reply[]
  likes          TopicLike[]
  reports        ForumReport[]

  @@index([category])
  @@index([isPinned])
  @@index([lastActivityAt])
  @@map("topics")
}

model Reply {
  id         String        @id @default(cuid())
  content    String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  isSolution Boolean       @default(false)
  isEdited   Boolean       @default(false)
  editedAt   DateTime?     @db.Timestamptz(6)
  likeCount  Int           @default(0)
  topicId    String
  authorId   String
  author     User          @relation(fields: [authorId], references: [id])
  topic      Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  likes      ReplyLike[]
  reports    ForumReport[]

  @@index([topicId])
  @@index([isSolution], map: "replies_is_solution_idx")
  @@map("replies")
}

model TopicLike {
  id        String   @id @default(cuid())
  topicId   String
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User     @relation("UserTopicLikes", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([topicId, userId], map: "topic_likes_topic_user_unique")
  @@index([topicId], map: "topic_likes_topic_idx")
  @@index([userId], map: "topic_likes_user_idx")
  @@map("topic_likes")
}

model ReplyLike {
  id        String   @id @default(cuid())
  replyId   String
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  reply     Reply    @relation(fields: [replyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User     @relation("UserReplyLikes", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([replyId, userId], map: "reply_likes_reply_user_unique")
  @@index([replyId], map: "reply_likes_reply_idx")
  @@index([userId], map: "reply_likes_user_idx")
  @@map("reply_likes")
}

model ForumReport {
  id         String            @id @default(cuid())
  reason     String
  details    String?
  status     ForumReportStatus @default(PENDING)
  reporterId String
  topicId    String?
  replyId    String?
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  reporter   User              @relation("UserForumReports", fields: [reporterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  topic      Topic?            @relation(fields: [topicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reply      Reply?            @relation(fields: [replyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status])
  @@index([topicId], map: "forum_reports_topic_idx")
  @@index([replyId], map: "forum_reports_reply_idx")
  @@index([reporterId], map: "forum_reports_reporter_idx")
  @@map("forum_reports")
}

model AdminRole {
  id               String                @id @default(cuid())
  name             String                @unique
  description      String?
  isSystem         Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  requiresApproval Boolean               @default(false)
  permissions      AdminRolePermission[]
  userRoles        UserAdminRole[]

  @@map("admin_roles")
}

model Permission {
  id          String                @id @default(cuid())
  code        String                @unique
  module      String
  action      String
  description String?
  createdAt   DateTime              @default(now())
  roles       AdminRolePermission[]

  @@map("permissions")
}

model AdminRolePermission {
  id           String     @id @default(cuid())
  adminRoleId  String
  permissionId String
  createdAt    DateTime   @default(now())
  adminRole    AdminRole  @relation(fields: [adminRoleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([adminRoleId, permissionId])
  @@map("admin_role_permissions")
}

model UserAdminRole {
  id              String              @id @default(cuid())
  userId          String
  adminRoleId     String
  assignedBy      String?
  assignedAt      DateTime            @default(now())
  expiresAt       DateTime?
  isActive        Boolean             @default(true)
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedBy      String?
  status          UserAdminRoleStatus @default(PENDING)
  role            AdminRole           @relation(fields: [adminRoleId], references: [id], onDelete: Cascade)
  assignedByUser  User?               @relation("AdminRoleAssignment", fields: [assignedBy], references: [id])
  reviewedByUser  User?               @relation("AdminRoleReviewer", fields: [reviewedBy], references: [id])
  user            User                @relation("UserAdminRoles", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, adminRoleId])
  @@map("user_admin_roles")
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  password               String
  firstName              String
  lastName               String
  role                   Role                    @default(MEMBER)
  isActive               Boolean                 @default(false)
  isVerified             Boolean                 @default(false)
  twoFactorEnabled       Boolean                 @default(false)
  twoFactorSecret        String?
  avatarUrl              String?                 @map("avatar_url")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  lastLoginAt            DateTime?
  approvalSteps          ApprovalStep[]
  createdApprovals       ApprovalWorkflow[]      @relation("ApprovalCreatedBy")
  reviewedApprovals      ApprovalWorkflow[]      @relation("ApprovalReviewedBy")
  auditLogs              AuditLog[]
  events                 Event[]                 @relation("EventCreator")
  memberships            MembershipRequest[]
  posts                  Post[]
  replies                Reply[]
  topics                 Topic[]
  assignedRoles          UserAdminRole[]         @relation("AdminRoleAssignment")
  reviewedAdminRoles     UserAdminRole[]         @relation("AdminRoleReviewer")
  adminRoles             UserAdminRole[]         @relation("UserAdminRoles")
  createdFormations      Formation[]             @relation("FormationCreator")
  createdJobs            Job[]                   @relation("JobCreator")
  createdOpportunities   Opportunity[]           @relation("OpportunityCreator")
  clubAssignments        ClubAssignment[]        @relation("UserClubAssignments")
  assignedClubRoles      ClubAssignment[]        @relation("ClubAssignmentCreator")
  notifications          Notification[]          @relation("UserNotifications")
  notificationReads      NotificationRead[]      @relation("UserNotificationReads")
  pushSubscriptions      PushSubscription[]      @relation("UserPushSubscriptions")
  analyticsEvents        AnalyticsEvent[]        @relation("UserAnalyticsEvents")
  formationRegistrations FormationRegistration[] @relation("UserFormationRegistrations")
  topicLikes             TopicLike[]             @relation("UserTopicLikes")
  replyLikes             ReplyLike[]             @relation("UserReplyLikes")
  forumReports           ForumReport[]           @relation("UserForumReports")
  postLikes              PostLike[]              @relation("UserPostLikes")
  positionReports        PositionReport[]        @relation("PositionReportAuthor")
  reviewedReports        PositionReport[]        @relation("PositionReportReviewer")
  positionReportEvents   PositionReportEvent[]   @relation("PositionReportActor")
  mentorships            Mentorship[]            @relation("MentorshipMentor")
  menteeships            Mentorship[]            @relation("MentorshipMentee")
  createdMentorships     Mentorship[]            @relation("MentorshipCreator")
  formationTrainings     FormationTrainer[]      @relation("FormationTrainerUser")
  mentorReports          MentorReport[]          @relation("MentorReportAuthor")
  reviewedMentorReports  MentorReport[]          @relation("MentorReportReviewer")
  staffThreadMessages    StaffMessage[]          @relation("StaffMessageThread")
  staffMessages          StaffMessage[]          @relation("StaffMessageAuthor")

  @@map("users")
}

model ClubPosition {
  id              String           @id @default(cuid())
  title           String           @unique
  description     String?
  category        String           @default("BUREAU_EXECUTIF")
  order           Int              @default(0)
  isSystem        Boolean          @default(false)
  // Rapports d'activité : modèle utilisé, rythme attendu et délai de remise
  // (en jours après la fin de la période)
  reportTemplate  String?
  reportFrequency String           @default("MONTHLY")
  reportDueDays   Int              @default(7)
  // Lecture de tous les rapports soumis (Présidence, Vice-Présidence)
  seesAllReports  Boolean          @default(false)
  // Poste supérieur qui lit les rapports de ce poste (ex. adjoint -> titulaire)
  reportsToId     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  assignments     ClubAssignment[]
  reportsTo       ClubPosition?    @relation("PositionHierarchy", fields: [reportsToId], references: [id], onDelete: SetNull)
  subordinates    ClubPosition[]   @relation("PositionHierarchy")
  reports         PositionReport[]

  @@index([order])
  @@index([category])
  @@map("club_positions")
}

model ClubAssignment {
  id           String       @id @default(cuid())
  positionId   String
  userId       String
  mandateYear  String?
  startDate    DateTime     @default(now())
  endDate      DateTime?
  isActive     Boolean      @default(true)
  notes        String?
  // TITULAIRE : la personne nommée au poste ; EQUIPE : membre de l'équipe
  // d'un poste de responsable (pôle)
  memberRole   String       @default("TITULAIRE")
  assignedById String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  position     ClubPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  user         User         @relation("UserClubAssignments", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User?        @relation("ClubAssignmentCreator", fields: [assignedById], references: [id])

  @@index([userId])
  @@index([positionId])
  @@index([isActive])
  @@map("club_assignments")
}

// Rapport d'activité rédigé par un membre du bureau au titre de son poste
model PositionReport {
  id            String                @id @default(cuid())
  positionId    String
  authorId      String
  // Période couverte : "2026-10" (mois), "2026-T4" (trimestre), "2026" (année), ou aucune
  periodKey     String?
  title         String
  // Contenu structuré selon le modèle du poste (sections texte et tableaux)
  content       Json                  @default("{}")
  attachments   Json                  @default("[]")
  status        PositionReportStatus  @default(DRAFT)
  // Totaux en FCFA calculés à partir des tableaux de trésorerie
  incomeTotal   Int                   @default(0)
  expenseTotal  Int                   @default(0)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewComment String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  position      ClubPosition          @relation(fields: [positionId], references: [id], onDelete: Cascade)
  author        User                  @relation("PositionReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewedBy    User?                 @relation("PositionReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  events        PositionReportEvent[]

  @@index([positionId, periodKey])
  @@index([authorId])
  @@index([status])
  @@map("position_reports")
}

// Historique d'un rapport : soumissions, validations, demandes de correction
model PositionReportEvent {
  id        String         @id @default(cuid())
  reportId  String
  actorId   String?
  action    String
  comment   String?
  createdAt DateTime       @default(now())
  report    PositionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor     User?          @relation("PositionReportActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@map("position_report_events")
}

// Binôme de mentorat attribué par la Présidence
model Mentorship {
  id            String         @id @default(cuid())
  mentorId      String
  // Mentoré inscrit sur le site, ou simple nom pour une personne sans compte
  menteeId      String?
  menteeName    String
  menteeContact String?
  goals         String?
  status        String         @default("ACTIVE")
  startDate     DateTime       @default(now())
  endDate       DateTime?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  mentor        User           @relation("MentorshipMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee        User?          @relation("MentorshipMentee", fields: [menteeId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("MentorshipCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reports       MentorReport[]

  @@index([mentorId])
  @@index([menteeId])
  @@map("mentorships")
}

// Mentor animateur d'une formation
model FormationTrainer {
  id          String    @id @default(cuid())
  formationId String
  userId      String
  createdAt   DateTime  @default(now())
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  user        User      @relation("FormationTrainerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([formationId, userId])
  @@index([userId])
  @@map("formation_trainers")
}

// Compte rendu d'un mentor : séance de mentorat ou session de formation animée.
// Confidentiel : lu par son auteur et la Présidence uniquement.
model MentorReport {
  id            String               @id @default(cuid())
  authorId      String
  // MENTORAT ou SESSION_FORMATION
  kind          String
  mentorshipId  String?
  formationId   String?
  title         String
  content       Json                 @default("{}")
  attachments   Json                 @default("[]")
  // Historique : [{ action, actorId, actor, comment, createdAt }]
  history       Json                 @default("[]")
  status        PositionReportStatus @default(DRAFT)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewComment String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  author        User                 @relation("MentorReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewedBy    User?                @relation("MentorReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  mentorship    Mentorship?          @relation(fields: [mentorshipId], references: [id], onDelete: SetNull)
  formation     Formation?           @relation(fields: [formationId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([status])
  @@index([mentorshipId])
  @@index([formationId])
  @@map("mentor_reports")
}

// Messagerie de coordination : un fil par membre de l'équipe (mentor) avec la Présidence
model StaffMessage {
  id           String    @id @default(cuid())
  threadUserId String
  authorId     String
  body         String
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  threadUser   User      @relation("StaffMessageThread", fields: [threadUserId], references: [id], onDelete: Cascade)
  author       User      @relation("StaffMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadUserId, createdAt])
  @@map("staff_messages")
}

// Profil anonyme d'un visiteur (identifiant de session du navigateur, aucune adresse IP)
model VisitorProfile {
  id             String    @id @default(cuid())
  sessionId      String    @unique @db.VarChar(128)
  userId         String?
  // Déclaré par le visiteur (facultatif)
  status         String?   @db.VarChar(50)
  educationLevel String?   @db.VarChar(60)
  interests      String[]  @default([])
  // Déduit des en-têtes de la plateforme d'hébergement (pays / région / ville)
  country        String?   @db.VarChar(2)
  region         String?   @db.VarChar(80)
  city           String?   @db.VarChar(120)
  device         String?   @db.VarChar(20)
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  visitsCount    Int       @default(1)
  pagesCount     Int       @default(0)
  totalSeconds   Int       @default(0)
  profiledAt     DateTime?

  @@index([status])
  @@index([country])
  @@index([lastSeenAt])
  @@index([firstSeenAt])
  @@map("visitor_profiles")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  module     String
  resource   String?
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  result     String
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([module, createdAt])
  @@map("audit_logs")
}

// Paramètres de plateforme (clé/valeur). Les paramètres sensibles
// (maintenance, sécurité) exigent une ré-authentification pour être modifiés.
model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String   @default("general")
  label       String?
  isSensitive Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model ApprovalWorkflow {
  id           String           @id @default(cuid())
  resourceType String
  resourceId   String
  action       String
  status       ApprovalStatus   @default(PENDING)
  priority     ApprovalPriority @default(NORMAL)
  comment      String?
  metadata     Json?
  createdById  String
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  steps        ApprovalStep[]
  createdBy    User             @relation("ApprovalCreatedBy", fields: [createdById], references: [id])
  reviewedBy   User?            @relation("ApprovalReviewedBy", fields: [reviewedById], references: [id])

  @@unique([resourceType, resourceId, action])
  @@map("approval_workflows")
}

model ApprovalStep {
  id           String             @id @default(cuid())
  workflowId   String
  approverRole String
  approverId   String?
  status       ApprovalStepStatus @default(PENDING)
  comment      String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  approver     User?              @relation(fields: [approverId], references: [id])
  workflow     ApprovalWorkflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, approverRole])
  @@map("approval_steps")
}

// Rôle de base du compte. Les rôles administratifs spécialisés
// (ADMIN_FORMATION, ADMIN_METIER, ADMIN_BLOG, ADMIN_FORUM...) vivent
// uniquement dans AdminRole/UserAdminRole : c'est la table RBAC qui fait foi.
// ADMIN = membre du staff (au moins un rôle admin approuvé ou rôle de base).
enum Role {
  ADMIN
  MEMBER
  VISITOR
  ULTRA_ADMIN
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventType {
  ATELIER
  CONFERENCE
  RENCONTRE
  FORMATION
}

enum JobCategory {
  TECH
  ENERGIE
  FINANCE
  SECURITE
  SANTE
  EDUCATION
  AUTRE
}

enum PostStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

// Cycle de vie éditorial des formations et métiers :
// DRAFT (brouillon) → PENDING_REVIEW (soumis à validation) → PUBLISHED
// Un contenu publié peut être dépublié (retour brouillon) ou archivé.
enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum PostCategory {
  CLUB
  FORMATION
  ATELIER
  RENCONTRE
  CONFERENCE
  VISITE
  PROJET
  TEMOIGNAGE
  ANNONCE
}

enum UserAdminRoleStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  REVOKED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum PositionReportStatus {
  DRAFT
  SUBMITTED
  NEEDS_CHANGES
  VALIDATED
}

enum NotificationType {
  FORMATION
  JOB
  BLOG
  FORUM
  ANNOUNCEMENT
  MEMBERSHIP
  SYSTEM
}

enum ForumReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

model Notification {
  id        String             @id @default(cuid())
  userId    String?
  type      NotificationType   @default(SYSTEM)
  title     String
  message   String
  url       String?
  imageUrl  String?
  dedupeKey String?            @unique
  isRead    Boolean            @default(false)
  readAt    DateTime?
  createdAt DateTime           @default(now())
  user      User?              @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  reads     NotificationRead[]

  @@index([userId])
  @@index([userId, isRead, createdAt])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation("UserNotificationReads", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_reads")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model AnalyticsEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String    @map("session_id") @db.VarChar(128)
  userId      String?   @map("user_id")
  userProfile String?   @map("user_profile") @db.VarChar(50)
  eventType   String    @map("event_type") @db.VarChar(100)
  entityType  String?   @map("entity_type") @db.VarChar(50)
  entityId    String?   @map("entity_id") @db.VarChar(255)
  metadata    Json?     @default("{}") @map("metadata")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation("UserAnalyticsEvents", fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([sessionId], map: "idx_analytics_events_session_id")
  @@index([userId], map: "idx_analytics_events_user_id")
  @@index([eventType], map: "idx_analytics_events_event_type")
  @@index([entityType, entityId], map: "idx_analytics_events_entity")
  @@index([createdAt], map: "idx_analytics_events_created_at")
  @@index([userProfile], map: "idx_analytics_events_user_profile")
  @@map("analytics_events")
}

// Agrégats quotidiens d'analytics : table alimentée par analytics_retention_cron.sql
// (déclarée ici pour que les migrations Prisma ne la suppriment jamais).
model AnalyticsDailyStat {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  statDate       DateTime  @map("stat_date") @db.Date
  eventType      String    @map("event_type") @db.VarChar(100)
  entityType     String?   @default("") @map("entity_type") @db.VarChar(50)
  entityId       String?   @default("") @map("entity_id") @db.VarChar(255)
  userProfile    String?   @default("") @map("user_profile") @db.VarChar(50)
  totalEvents    Int       @default(0) @map("total_events")
  uniqueSessions Int       @default(0) @map("unique_sessions")
  uniqueUsers    Int       @default(0) @map("unique_users")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([statDate, eventType, entityType, entityId, userProfile], map: "uq_analytics_daily_stats")
  @@index([statDate(sort: Desc)], map: "idx_analytics_daily_stats_date")
  @@index([entityType, entityId], map: "idx_analytics_daily_stats_entity")
  @@index([eventType], map: "idx_analytics_daily_stats_type")
  @@map("analytics_daily_stats")
}
