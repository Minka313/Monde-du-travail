{
  "name": "monde-du-travail",
  "version": "1.0.0",
  "private": true,
  "description": "Plateforme web et API pour Le Monde du Travail",
  "scripts": {
    "postinstall": "prisma generate --schema=backend/prisma/schema.prisma",
    "build": "prisma generate --schema=backend/prisma/schema.prisma",
    "vercel-build": "prisma generate --schema=backend/prisma/schema.prisma",
    "start": "cd backend && npm start",
    "dev": "cd backend && npm run dev"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
